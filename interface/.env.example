###
# INTERFACE LOCAL DEVELOPMENT
# Copy this file to interface/.env before running `npm run dev` from interface/.
#
# This file is for running Next.js directly on the host. Docker Compose instead
# reads the root .env and .env.global files, where service hostnames and mounted
# credential paths are different.
###

# ---------------------------------------------------------
# Database
# ---------------------------------------------------------
# Start PostgreSQL locally or expose the Compose database on this host port.
DB_HOST="localhost"
DB_PORT=5432
DB_USER="postgres"
DB_PASSWORD="postgres"
DB_NAME="postgres"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"

# ---------------------------------------------------------
# Discord OAuth and bot invites
# ---------------------------------------------------------
DISCORD_CLIENT_ID="your_client_id_here"
DISCORD_CLIENT_SECRET="your_client_secret_here"
DISCORD_BOT_SCOPE="guilds bot applications.commands identify"
DISCORD_BOT_PERMISSIONS="65536"
DISCORD_INVITES_DISABLED="0"
OWNER_DISCORD_ID=

# Register http://localhost:3000/api/auth/callback/discord as a Discord OAuth
# redirect and restart the dev server after changing these values.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="changeme"

# ---------------------------------------------------------
# Bot API and internal authentication
# ---------------------------------------------------------
# Use localhost when the bot API is exposed from Docker or run directly.
# Docker Compose uses http://bot-api:8000 instead.
BOT_API_URL="http://localhost:8000"
BOT_API_TIMEOUT_MS=2000
INTERNAL_API_TOKEN="changeme"
INTERNAL_HEALTH_TOKEN="changeme"

# ---------------------------------------------------------
# Redis
# ---------------------------------------------------------
# Used for interface cache invalidation. Docker Compose uses dcs-redis.
REDIS_URL="redis://localhost:6379"
REDIS_CONNECT_BACKOFF_INITIAL_SECONDS=0.5
REDIS_CONNECT_BACKOFF_MAX_SECONDS=30
REDIS_CONNECT_BACKOFF_MULTIPLIER=2
REDIS_CONNECT_TIMEOUT_SECONDS=2
REDIS_CONNECT_MAX_ATTEMPTS=5

# ---------------------------------------------------------
# Thumbnail storage
# ---------------------------------------------------------
# Local mode reads the same python/storage directory used by a worker launched
# from python/. Docker uses /app/storage instead.
STORAGE_TYPE="local" # local | gcs
STORAGE_PATH="../python/storage"

# To read private GCS thumbnails while running Next.js directly, switch
# STORAGE_TYPE to gcs and uncomment this block. GOOGLE_APPLICATION_CREDENTIALS
# must be an absolute path visible on the host process.
#
# GCS_BUCKET_NAME="discord-clip-thumbnails"
# GCS_PROJECT_ID="your-gcp-project"
# Linux/macOS:
# GOOGLE_APPLICATION_CREDENTIALS="/home/yourname/.gcp/discordclipsaver-gcs.json"
# Windows:
# GOOGLE_APPLICATION_CREDENTIALS="C:/Users/yourname/.gcp/discordclipsaver-gcs.json"
# GCS_SIGNED_URL_TTL_SECONDS=3900
# THUMBNAIL_BROWSER_CACHE_SECONDS=3600
# GCS_LOCAL_FALLBACK_PATH="../python/storage"
#
# Do not set GCS_CREDENTIALS_FILE here. It is only used by the root Compose
# configuration to mount the host JSON at:
# /var/run/secrets/google/service-account.json

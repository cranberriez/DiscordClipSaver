###
# PYTHON SERVICES LOCAL DEVELOPMENT
# Copy this file to python/.env before running commands from python/, for example:
#   python -m bot.main
#   python -m worker.main
#
# This shared host-local file supports the bot API, Discord gateway, and worker.
# A legacy bot/.env or worker/.env is closer to that service module and takes
# precedence during dotenv discovery; remove or update it when adopting this file.
# Docker Compose instead reads the root .env and .env.global files, where service
# hostnames, storage paths, and mounted credential paths are different.
###

# ---------------------------------------------------------
# Discord bot
# ---------------------------------------------------------
BOT_TOKEN="your_discord_bot_token_here"
BOT_RUNTIME_MODE="all" # all | api | discord
DISCORD_MEMBERS_INTENT=true
DISCORD_PERMISSION_CACHE_TTL_SECONDS=300

# ---------------------------------------------------------
# Database
# ---------------------------------------------------------
# Start PostgreSQL locally or expose the Compose database on this host port.
DB_HOST="localhost"
DB_PORT=5432
DB_TYPE="postgres"
DB_USER="postgres"
DB_PASSWORD="postgres"
DB_NAME="postgres"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"

DB_POOL_MIN=2
DB_POOL_MAX=10
DB_MAX_QUERIES=50000
DB_MAX_IDLE_TIME=300
DB_RETRY_MAX_ATTEMPTS=3
DB_RETRY_BASE_DELAY=0.5
DB_RETRY_MAX_DELAY=10.0
DB_HEALTH_CHECK_INTERVAL=60

# Set to 1 only when this local process should create missing schemas.
DB_GENERATE_SCHEMAS="0"
DB_SCHEMA_INIT_MAX_ATTEMPTS=10
DB_SCHEMA_INIT_RETRY_SECONDS=2

# ---------------------------------------------------------
# Bot API authentication
# ---------------------------------------------------------
# Must match INTERNAL_API_TOKEN in interface/.env.
INTERNAL_API_TOKEN="changeme"

# ---------------------------------------------------------
# Redis and worker
# ---------------------------------------------------------
# Docker Compose uses redis://dcs-redis:6379.
REDIS_URL="redis://localhost:6379"
REDIS_CLAIM_MIN_IDLE_MS=900000
REDIS_CONNECT_BACKOFF_INITIAL_SECONDS=0.5
REDIS_CONNECT_BACKOFF_MAX_SECONDS=30
REDIS_CONNECT_BACKOFF_MULTIPLIER=2
REDIS_CONNECT_TIMEOUT_SECONDS=2
REDIS_CONNECT_MAX_ATTEMPTS=5

WORKER_MODE="all" # all | discord | maintenance
WORKER_JOB_BATCH_SIZE=10

# ---------------------------------------------------------
# Thumbnail storage
# ---------------------------------------------------------
STORAGE_TYPE="local" # local | gcs
STORAGE_PATH="./storage"

# To have a directly launched worker write thumbnails to GCS, switch
# STORAGE_TYPE to gcs and uncomment this block. GOOGLE_APPLICATION_CREDENTIALS
# must be an absolute path visible on the host process.
#
# GCS_BUCKET_NAME="discord-clip-thumbnails"
# GCS_PROJECT_ID="your-gcp-project"
# Linux/macOS:
# GOOGLE_APPLICATION_CREDENTIALS="/home/yourname/.gcp/discordclipsaver-gcs.json"
# Windows:
# GOOGLE_APPLICATION_CREDENTIALS="C:/Users/yourname/.gcp/discordclipsaver-gcs.json"
# GCS_SIGNED_URL_TTL_SECONDS=3900
# THUMBNAIL_BROWSER_CACHE_SECONDS=3600
# GCS_LOCAL_FALLBACK_PATH="./storage"
#
# Do not set GCS_CREDENTIALS_FILE here. It is only used by the root Compose
# configuration to mount the host JSON at:
# /var/run/secrets/google/service-account.json

VIDEO_DOWNLOAD_TIMEOUT=300
VIDEO_DOWNLOAD_CONNECT_TIMEOUT=10

THUMBNAIL_SMALL_WIDTH=320
THUMBNAIL_SMALL_HEIGHT=180
THUMBNAIL_LARGE_WIDTH=640
THUMBNAIL_LARGE_HEIGHT=360
THUMBNAIL_TIMESTAMP=1.0
THUMBNAIL_QUALITY=85

# ---------------------------------------------------------
# Shared settings and maintenance
# ---------------------------------------------------------
DEFAULT_SETTINGS_PATH="../settings.default.jsonc"
SETTINGS_CACHE_TTL_SECONDS=300
PURGE_COOLDOWN_MINUTES=5
LOG_LEVEL="INFO"
